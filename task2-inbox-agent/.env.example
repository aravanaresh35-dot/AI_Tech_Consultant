# Copy to .env (never commit .env). With no ANTHROPIC_* values everything runs in clearly-labelled DEMO mode.
DEMO_MODE=auto              # auto = live only if key+model set | true = force demo | false = force live (fails loudly)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=            # a model id you have verified is available to your account (none is hard-coded)
MODEL_PRICE_INPUT_PER_MTOK= # optional, USD per million tokens, from the provider's price page; blank = cost "unavailable"
MODEL_PRICE_OUTPUT_PER_MTOK=
KNOWLEDGE_BRAIN_URL=http://localhost:8001
CRAWL_SOURCE=demo           # demo = offline fixtures | live = real sitemap (polite crawl, robots.txt respected)
SYNC_SCHEDULE_ENABLED=false # true = daily sync job inside the Knowledge Brain process (hour: SYNC_HOUR_UTC)
HOURLY_RATE=                # optional; blank = proposal shows NO monetary amount
CURRENCY=USD
AUTO_SEND_ENABLED=false     # Inbox Agent: even when true, sending is only SIMULATED (outbound queue)
